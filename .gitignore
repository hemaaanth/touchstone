# Dependencies
node_modules/

# Secrets — never commit
.env
.env.local
*.env.local
.env.*.local

# Build output
app/dist/
*.tsbuildinfo

# Foundry build artifacts
lab/*/out/
lab/*/cache/

# Per-run sandbox SQLite state (the app reads run-*.json / run-*.events only)
spike/results/**/*.sqlite

# Operator-configured scopes (briefs, local folders) — machine-local, not our
# source. The labs that ship in this repo are built into targets.mjs instead.
spike/data/

# Logs
*.log

# Mutating runtime spend trackers (regenerated per run)
spike/spend.json
spike/spend-openrouter.json

# Reference clones — competitor/learning repos, not our code
reference/

# Static-engine binary — a build artifact, not our source. Fetched by
# tools/install-aderyn.sh (pinned version). Keep it out of the tree.
tools/bin/

# Large research corpus and design-exploration scratch (not the app)
research/
design-directions/

# BB internal
.bb/

# OS
.DS_Store
