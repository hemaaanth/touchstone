", p, { headers: at }); out.probes[p] = { s: r.status, b: r.status === 200 ? String(r.resBody).slice(0, 130) : \"\" }; }\nreturn out;"}},{"name":"run_request_script","args":{"label":"address-binding-1","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst B = \"0x70997970C51812dc3A010C7d01b50e0d17dc79C8\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst h = { \"content-type\": \"application/json\" };\nconst out = {};\nconst n1 = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nconst m1 = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce: n1, issuedAt: new Date().toISOString() });\nconst s1 = await signPersonal(AK, m1);\nout.control = J((await request(\"POST\", \"/siwe/verify\", { headers: h, body: JSON.stringify({ message: m1, signature: s1 }) })).resBody);\nconst n2 = J((await request(\"GET\", \"/siwe/nonce\")).resBody).nonce;\nconst m2 = buildSiwe({ domain: \"touchstone.lab\", address: B, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce: n2, issuedAt: new Date().toISOString() });\nconst s2 = await signPersonal(AK, m2);\nconst v2 = await request(\"POST\", \"/siwe/verify\", { headers: h, body: JSON.stringify({ message: m2, signature: s2 }) });\nout.forgedAsBob = { s: v2.status, b: J(v2.resBody) };\nif (out.forgedAsBob.b && out.forgedAsBob.b.token) {\n  out.forgedMe = (await request(\"GET\", \"/api/me\", { headers: { authorization: \"Bearer \" + out.forgedAsBob.b.token } })).resBody;\n}\nconst probes = [\"/api/users/1/mnemonic\",\"/api/users/1/seed\",\"/api/users/1/pk\",\"/api/keys/1\",\"/api/users?id=2\",\"/api/user?id=2\",\"/api/v1/me\",\"/api/session\",\"/api/me/token\",\"/healthz\",\"/api/users/1/wallet?full=1\"];\nout.probes = {};\nfor (const p of probes) { const r = await request(\"GET\", p); out.probes[p] = { s: r.status, b: r.status === 200 ? String(r.resBody).slice(0, 120) : \"\" }; }\nreturn out;"}},{"name":"run_request_script","args":{"label":"token-quirks-1","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst n = await request(\"GET\", \"/siwe/nonce\");\nconst msg = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce: J(n.resBody).nonce, issuedAt: new Date().toISOString() });\nconst sig = await signPersonal(AK, msg);\nconst v = await request(\"POST\", \"/siwe/verify\", { headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ message: msg, signature: sig }) });\nconst t = J(v.resBody).token;\nconst H = (val) => ({ authorization: val });\nconst out = { len: t.length };\nout.full = (await request(\"GET\", \"/api/me\", { headers: H(\"Bearer \" + t) })).status;\nout.prefix8 = (await request(\"GET\", \"/api/me\", { headers: H(\"Bearer \" + t.slice(0, 8)) })).status;\nout.prefix16 = (await request(\"GET\", \"/api/me\", { headers: H(\"Bearer \" + t.slice(0, 16)) })).status;\nout.prefix24 = (await request(\"GET\", \"/api/me\", { headers: H(\"Bearer \" + t.slice(0, 24)) })).status;\nout.upper = (await request(\"GET\", \"/api/me\", { headers: H(\"Bearer \" + t.toUpperCase()) })).status;\nout.extraChar = (await request(\"GET\", \"/api/me\", { headers: H(\"Bearer \" + t + \"x\") })).status;\nout.noScheme = (await request(\"GET\", \"/api/me\", { headers: H(t) })).status;\nout.lowerScheme = (await request(\"GET\", \"/api/me\", { headers: H(\"bearer \" + t) })).status;\nout.query = (await request(\"GET\", \"/api/me?token=\" + t)).status;\nconst at = { authorization: \"Bearer \" + t };\nout.ids = {};\nfor (const id of [\"2.0\", \"%32\", \"2abc\", \"02\", \"-1\", \"1e0\"]) {\n  const r = await request(\"GET\", \"/api/users/\" + id, { headers: at });\n  out.ids[id] = { s: r.status, b: String(r.resBody).slice(0, 90) };\n}\nout.misc = {\n  healthz: (await request(\"GET\", \"/healthz\")).resBody,\n  root: (await request(\"GET\", \"/\")).status,\n  optUsers2: (await request(\"OPTIONS\", \"/api/users/2\")).resHeaders\n};\nreturn out;"}},{"name":"run_request_script","args":{"label":"enum-3","script":"const A = \"0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\";\nconst AK = \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\";\nconst J = (x) => typeof x === \"string\" ? JSON.parse(x) : x;\nconst n = await request(\"GET\", \"/siwe/nonce\");\nconst msg = buildSiwe({ domain: \"touchstone.lab\", address: A, uri: \"http://touchstone.lab/siwe\", version: \"1\", chainId: 31337, nonce: J(n.resBody).nonce, issuedAt: new Date().toISOString() });\nconst sig = await signPersonal(AK, msg);\nconst v = await request(\"POST\", \"/siwe/verify\", { headers: { \"content-type\": \"application/json\" }, body: JSON.stringify({ message: msg, signature: sig }) });\nconst at = { authorization: \"Bearer \" + J(v.resBody).token, \"content-type\": \"application/json\" };\nconst paths = [\"/api/users/1/balance\",\"/api/users/1/email\",\"/api/users/1/name\",\"/api/users/1/address\",\"/api/balance\",\"/api/address/0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\",\"/api/wallet/0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266\",\"/api/addresses\",\"/api/contracts\",\"/api/network\",\"/api/gas\",\"/api/users/1/wallet/\",\"/api/me/\",\"/siwe/logout\",\"/logout\",\"/api/logout\",\"/login\",\"/api/login\",\"/admin\",\"/api/faucet\",\"/api/transfer\",\"/api/tx\",\"/api/users/1/tx\",\"/api/users/1/session\",\"/api/me/profile\",\"/api/me/keys\",\"/api/me/apiKey\",\"/api/apikeys\",\"/api/users/1/apiKey\",\"/api/status\",\"/api/health\",\"/api/admin/stats\",\"/api/stats\"];\nconst out = {};\nfor (const p of paths) {\n  const r = await request(\"GET\", p, { headers: at });\n  if (r.status !== 404) out[\"GET \" + p] = { s: r.status, b: String(