              "risk_area": "XSS / secrets / API discovery in JS",
              "surface": "/ and /s.js static page bundle",
              "recorded_by": "Recon Mapper",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/hidden-endpoints-sensitive-file-exposure",
          "ruleIndex": 2,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Hidden endpoints / sensitive file exposure — Requires further review: Catch-all 404 handler + common paths (robots, sitemap, .git, .env, config.json)\n\nEvery path returns the same 577-byte 404 page; katana d3 found only / and /s.js. ffuf wordlist run incomplete (no dirb/SecLists file present in sandbox)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Catch-all 404 handler + common paths (robots, sitemap, .git, .env, config.json)"
                }
              ]
            }
