      "results": [
        {
          "ruleId": "strix-coverage/exposed-services-attack-surface",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Exposed services / attack surface — No issue identified: example.com host/ports (80, 443, 8080, 8443)\n\nnaabu top-1000 + direct curl: only 80/443 serve (Cloudflare edge, 200). 8080 unanswered, 8443 returns nginx-style 400 to plain HTTP then TLS stalls."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "example.com host/ports (80, 443, 8080, 8443)"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Exposed services / attack surface",
              "surface": "example.com host/ports (80, 443, 8080, 8443)",
              "recorded_by": "Recon Mapper",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/xss-secrets-api-discovery-in-js",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "XSS / secrets / API discovery in JS — No issue identified: / and /s.js static page bundle\n\nReviewed full s.js (1963 B): no fetch/axios/GraphQL/WS, no tokens, no wallet/SIWE refs, no hardcoded keys or endpoints. Only sink is insertAdjacentHTML with literal strings."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/ and /s.js static page bundle"
                }
              ]
            }
          ],
          "properties": {
