              "recorded_by": "Recon Mapper",
              "source": "agent_reported"
            }
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "The scan ended with status 'interrupted' rather than completing, so coverage reflects only the work finished before it stopped."
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "5 agent(s) did not finish cleanly (Cache Poisoning Specialist, Origin 8443 and Desync Specialist, Path and Protocol Discovery Specialist, Proxy Evidence Recorder, Root Agent); any surface they held is under-covered."
              }
            },
            {
              "level": "warning",
              "message": {
