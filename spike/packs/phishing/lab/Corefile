# Lab DNS for the phishing pack. Every name is under the reserved .test TLD.
# Addresses are TEST-NET-1 (192.0.2.0/24, RFC 5737). Nothing here routes.
tidekeep.test:53 {
  errors
  file /lab/tidekeep.test.db tidekeep.test
}
tldekeep.test:53 {
  errors
  file /lab/tldekeep.test.db tldekeep.test
}
tide-keep.test:53 {
  errors
  file /lab/tide-keep.test.db tide-keep.test
}
tidekeeep.test:53 {
  errors
  file /lab/tidekeeep.test.db tidekeeep.test
}
test:53 {
  errors
  file /lab/test.db test
}
# dnstwist also makes two .com names (tidekeep-test.com, tidekeeptest.com).
# This empty com zone answers NXDOMAIN for them, so nothing leaves the lab.
com:53 {
  errors
  file /lab/com.db com
}
