# mcp-shield 1.0.4, pinned by lockfile on a digest-pinned base. MIT license.
# Built with network access (npm ci). Run with a private lab network only.
# It runs pattern rules only: run.mjs never passes a Claude key, so mcp-shield
# makes no model call. The @anthropic-ai/sdk it depends on is installed, unused.
# Build: docker build -f spike/packs/ai-mcp/Dockerfile.shield -t touchstone/mcp-shield:1.0.4 spike/packs/ai-mcp
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
WORKDIR /opt/shield
COPY shield/package.json shield/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY shield/run.mjs shield/bridge.mjs ./
ENV HOME=/tmp
WORKDIR /work
ENTRYPOINT ["node", "/opt/shield/run.mjs"]
