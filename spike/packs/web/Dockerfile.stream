# The streamed browser: Chromium under Xvfb, plus Voxl (the low-latency streamer)
# and the desktop runtime from spike/roam/desktop.
#
# WHY A SECOND IMAGE. The capture image is headless and one-shot. A human who has
# to sign in needs to SEE the browser: that means an X display, a window manager
# and a streamer, which is 400 MB more and useless to a headless capture.
#
# VOXL. `voxl` 0.3.3 is copied in from the build context. It is the MIT binary
# from the BB sandbox image (GPL-2.0-or-later: it links x264). Its notices ship
# in /opt/touchstone/roam/desktop.
FROM touchstone/web-browser:1.65.1

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      xvfb openbox x11-utils \
      libx264-164 libyuv0 libopus0 libpulse0 libdbus-1-3 libx11-6 libxcb1 \
      libsystemd0 libsndfile1 libjpeg62-turbo libstdc++6; \
    rm -rf /var/lib/apt/lists/*
COPY roam/desktop/voxl /usr/local/bin/voxl
COPY roam/desktop/ /opt/touchstone/roam/desktop/
RUN chmod 0755 /usr/local/bin/voxl /opt/touchstone/roam/desktop/display-start.sh /opt/touchstone/roam/desktop/image-start.sh

# The display and the browser belong to the same fixed uid the host runs as.
ENV DISPLAY=:99 \
    TOUCHSTONE_ROAM_RUNTIME=1 \
    HOME=/tmp \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
USER node
WORKDIR /app
ENTRYPOINT []
