{
  "terraform": { "required_providers": { "aws": { "source": "hashicorp/aws", "version": "5.100.0" } } },
  "resource": {
    "aws_kms_key": {
      "signer": {
        "description": "Throwaway signer policy. Never deploy this lab.",
        "key_usage": "SIGN_VERIFY",
        "customer_master_key_spec": "ECC_SECG_P256K1",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":[\"kms:Sign\",\"kms:GetPublicKey\"],\"Resource\":\"*\"}]}",
        "tags": { "touchstone-role": "signer" }
      }
    },
    "aws_iam_role": {
      "ci_runner": {
        "name": "lab-ci-runner",
        "description": "Throwaway CI role. Any principal may assume it.",
        "assume_role_policy_document": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"sts:AssumeRole\"}]}",
        "tags": { "touchstone-role": "ci" }
      }
    },
    "aws_security_group": {
      "signer": {
        "name": "lab-signer",
        "description": "Internet ingress to the signer port",
        "ingress": [{ "from_port": 9000, "to_port": 9000, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"] }]
      }
    },
    "aws_instance": {
      "signer": {
        "ami": "ami-00000000000000000",
        "instance_type": "t3.micro",
        "vpc_security_group_ids": ["${aws_security_group.signer.id}"],
        "associate_public_ip_address": true,
        "tags": { "touchstone-role": "signer" }
      }
    },
    "aws_s3_bucket": {
      "frontend": {
        "bucket": "touchstone-lab-frontend",
        "acl": "public-read-write",
        "tags": { "touchstone-role": "frontend" }
      }
    },
    "aws_s3_bucket_versioning": {
      "frontend": {
        "bucket": "${aws_s3_bucket.frontend.id}",
        "versioning_configuration": { "status": "Suspended" }
      }
    },
    "aws_s3_bucket_public_access_block": {
      "frontend": {
        "bucket": "${aws_s3_bucket.frontend.id}",
        "block_public_acls": false,
        "block_public_policy": false,
        "ignore_public_acls": false,
        "restrict_public_buckets": false
      }
    },
    "aws_iam_role_policy": {
      "ci_frontend": {
        "name": "ci-write-frontend",
        "role": "lab-ci",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::touchstone-lab-frontend/*\"}]}"
      },
      "ci_runner_read": {
        "name": "lab-ci-read-any-bucket",
        "role": "${aws_iam_role.ci_runner.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":\"arn:aws:s3:::*\"}]}"
      }
    }
  }
}
